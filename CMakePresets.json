  ],
  "buildPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "targets": [
        "TooieRecompiled"
      ],
      "jobs": 6
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "targets": [
        "TooieRecompiled"
      ],
      "jobs": 6
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "targets": [
        "TooieRecompiled"
      ],
      "jobs": 6
    },
    {
      "name": "windows-player",
      "configurePreset": "windows-player",
      "targets": [
        "TooieBaseline"
      ],
      "jobs": 6
    },
    {
      "name": "linux-player",
      "configurePreset": "linux-player",
      "targets": [
        "TooieBaseline"
      ],
      "jobs": 6
    },
    {
      "name": "macos-player",
      "configurePreset": "macos-player",
      "targets": [
        "TooieBaseline"
      ],
      "jobs": 6
    }
  ],
  "testPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
