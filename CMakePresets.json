{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TOOIE_NATIVE_HOST": "ON",
        "TOOIE_DEPS_ROOT": "${sourceDir}/deps",
        "TOOIE_ROM_PATH": "${sourceDir}/baserom.us.z64"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows developer build (pinned clang-cl)",
      "description": "Run from an x64 Visual Studio 2022 Developer PowerShell after bootstrapping --with-windows-toolchain.",
      "inherits": "native-base",
      "environment": {
        "PATH": "${sourceDir}/deps/LLVM-19.1.3-Windows-X64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/deps/LLVM-19.1.3-Windows-X64/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/deps/LLVM-19.1.3-Windows-X64/bin/clang-cl.exe",
        "CMAKE_MT": "mt.exe",
        "CMAKE_CXX_FLAGS": "-Xclang -fexceptions -Xclang -fcxx-exceptions"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon developer build",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/macos-dev",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_PREFIX_PATH": "/opt/homebrew;/opt/homebrew/opt/openssl@3"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux developer build",
      "inherits": "native-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-player",
      "displayName": "Banjo-Tooie: Scurvy Dog Port Windows player",
      "description": "Configure the maintained Windows player using the prepared guest outputs and pinned toolchain; qualify the raw archive before linking.",
      "inherits": "windows-dev",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "cacheVariables": {
        "TOOIE_BASELINE": "ON",
        "TOOIE_BASELINE_BACKPACK621": "ON",
        "TOOIE_BASELINE_BOOT_OBSERVER": "ON",
        "TOOIE_BASELINE_BOOT_PI": "ON",
        "TOOIE_BASELINE_CAMERA_CPU_OBSERVER": "OFF",
        "TOOIE_BASELINE_CAMERA_IDENTITY": "ON",
        "TOOIE_BASELINE_CAMERA_RUNTIME_OBSERVER": "OFF",
        "TOOIE_BASELINE_CORE1_PUBLICATION": "ON",
        "TOOIE_BASELINE_CORE1_REFERENCE": "${sourceDir}/build/windows-dev/baseline/core1-publication/core1-observation.bin",
        "TOOIE_BASELINE_CORE2_REFERENCE": "${sourceDir}/build/windows-dev/baseline/core2-publication/core2-observation.bin",
        "TOOIE_BASELINE_CPU625": "ON",
        "TOOIE_BASELINE_EXTERNAL_WAIT_FIXTURE": "OFF",
        "TOOIE_BASELINE_FATAL_IMPORTS": "recomp_syscall_handler;__osGetSR_recomp;__osSetSR_recomp;__osSiRawReadIo_recomp;__osSiRawWriteIo_recomp;osMapTLBRdb_recomp;__osGetCause_recomp;__osSiGetAccess_recomp;__osSiRawStartDma_recomp;__osSiRelAccess_recomp;osViGetCurrentLine_recomp;osPfsInit_recomp",
        "TOOIE_BASELINE_FATAL_PROVIDERS": "boot___osException;boot_handle_CpU;boot___osDispatchThread;boot_osWritebackDCache;boot_osInvalICache;boot_osUnmapTLBAll;boot_osMapTLBRdb;boot___osGetCause;boot___osProbeTLB;func_8001DDC0;ovl_entrypoint_alternate",
        "TOOIE_BASELINE_HEAP_PATCH": "ON",
        "TOOIE_BASELINE_HONEY_EMIT": "OFF",
        "TOOIE_BASELINE_HONEY_PATCH": "OFF",
        "TOOIE_BASELINE_HOST": "ON",
        "TOOIE_BASELINE_LIFECYCLE_FIXTURE": "OFF",
        "TOOIE_BASELINE_NPC665": "ON",
        "TOOIE_BASELINE_PLAYER_BOUNDARY": "ON",
        "TOOIE_BASELINE_RENDERER_CANDIDATE_OUTPUT": "ON",
        "TOOIE_BASELINE_RENDERER_COMPARISON": "OFF",
        "TOOIE_BASELINE_RENDER_BRIDGE": "ON",
        "TOOIE_BASELINE_RENDER_OBSERVER": "OFF",
        "TOOIE_BASELINE_RT64_GENERIC_FIXES": "ON",
        "TOOIE_BASELINE_SAVE_COMPOSITION": "ON",
        "TOOIE_BASELINE_SAVE_DRAIN_FIXTURE": "OFF",
        "TOOIE_BASELINE_SILO_ACQUISITION_OBSERVER": "OFF",
        "TOOIE_BASELINE_SILO_CANDIDATE": "ON",
        "TOOIE_BASELINE_SILO_FAMILY_OBSERVER": "OFF",
        "TOOIE_BASELINE_SUCCESS_TRACE": "OFF",
        "TOOIE_BASELINE_TERMINAL_FENCE": "ON",
        "TOOIE_BASELINE_VI_CONTROLLER_CYCLE": "ON",
        "TOOIE_BASELINE_PLAYER": "ON",
        "TOOIE_NATIVE_HOST": "OFF",
        "TOOIE_BASELINE_MATRIX_TRACE": "ON",
        "TOOIE_BASELINE_PRESENT_TRACE": "ON",
        "TOOIE_BASELINE_RT64_VULKAN_ACQUIRE_PACING": "ON"
      }
    },
