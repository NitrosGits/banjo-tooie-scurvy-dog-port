      "description": "Selected player feature tuple on Apple Silicon. Shares the build folder name with windows-player because the guest preparation scripts write build/windows-dev; qualify its archive independently before linking.",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "cacheVariables": {
